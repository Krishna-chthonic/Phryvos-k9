# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# vault data (encrypted DB + backup bundles — never in VCS)
/data/
/backups/
/exports/
*.db
*.db-wal
*.db-shm
*.db-journal
*.bak
.phryvos.pid
.phryvos.log
.phryvos/worktrees/

# internal planning & reports
*MASTER_PLAN*.md
AUDIT_REPORT*.md
*.plan.md
